// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================
enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum BillType {
  CURRENT
  WIFI
  RENT
  WATER
  KHALA
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  CASH
  DEBT
  SELF
}

enum Unit {
  KG
  GRAM
  LITER
  ML
  PIECE
  DOZEN
  PACKET
  BOTTLE
}

enum InventoryCategory {
  FISH
  MEAT
  VEGETABLE
  FRUIT
  DAIRY
  OIL
  SPICE
  RICE
  OTHER
}

enum DebtStatus {
  DUE
  PAID
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_BANKING
}

enum NotificationType {
  BILL
  PAYMENT
  MEAL
  INVENTORY
  SUMMARY
  EMAIL
  SYSTEM
  STOCK_ALERT
}

// ==================== USER ====================
model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  phone             String?
  password          String
  role              Role              @default(MEMBER)
  profileImage      String?
  isActive          Boolean           @default(true)
  approvalStatus    ApprovalStatus    @default(PENDING)
  joinedDate        DateTime          @default(now())
  leftDate          DateTime?
  
  // Relations
  meals             Meal[]
  marketings        Marketing[]
  payments          Payment[]
  monthlySummaries  MonthlySummary[]
  userBalance       UserBalance?
  notifications     Notification[]
  emailLogs         EmailLog[]
  utilityBills      UtilityBill[]      @relation("Payer")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== USER BALANCE ====================
model UserBalance {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Decimal           @default(0)
  lastUpdated       DateTime          @default(now())
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MEAL ====================
model Meal {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  morning           Boolean           @default(false)
  lunch             Boolean           @default(false)
  dinner            Boolean           @default(false)
  totalMeal         Int               @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, date])
}

// ==================== INVENTORY ITEM (সরলীকৃত) ====================
model InventoryItem {
  id                String            @id @default(cuid())
  name              String
  category          InventoryCategory
  quantity          Decimal           @default(0)           // কত পিস/কেজি আছে
  minStockLevel     Decimal           @default(5)           // minimum stock alert
  lastUpdated       DateTime          @default(now())
  isActive          Boolean           @default(true)
  
  // Relations
  stockLogs         InventoryLog[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([name, category])
}

// ==================== INVENTORY LOG ====================
model InventoryLog {
  id                String            @id @default(cuid())
  inventoryItemId   String
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  change            Decimal           // positive = added, negative = removed
  previousQuantity  Decimal
  newQuantity       Decimal
  reason            String            // "PURCHASE", "USED", "WASTE", "ADJUSTMENT"
  note              String?
  date              DateTime          @default(now())
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MARKETING (Bazar) ====================
model Marketing {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime          @default(now())
  imageUrl          String?  
  shopName          String?
  totalAmount       Decimal           @default(0)
  note              String?
  paymentType       PaymentType       @default(CASH)
  
  // Relations
  items             MarketingItem[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MARKETING ITEM ====================
model MarketingItem {
  id                String            @id @default(cuid())
  marketingId       String
  marketing         Marketing         @relation(fields: [marketingId], references: [id], onDelete: Cascade)
  itemName          String
  quantity          Decimal
  unit              Unit              @default(KG)
  price             Decimal
  totalPrice        Decimal
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== UTILITY BILL ====================
model UtilityBill {
  id                String            @id @default(cuid())
  billType          BillType
  monthYear         DateTime
  amount            Decimal
  paidBy            String?
  payer             User?             @relation("Payer", fields: [paidBy], references: [id])
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== SHOP DEBT ====================
model ShopDebt {
  id                String            @id @default(cuid())
  shopName          String
  date              DateTime          @default(now())
  itemDetails       String?
  amount            Decimal
  status            DebtStatus        @default(DUE)
  paidDate          DateTime?
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== PAYMENT ====================
model Payment {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal
  paymentDate       DateTime          @default(now())
  paymentMethod     PaymentMethod     @default(CASH)
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MONTHLY SUMMARY ====================
model MonthlySummary {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthYear         DateTime
  totalMeal         Int               @default(0)
  mealRate          Decimal           @default(0)
  mealBill          Decimal           @default(0)
  utilityShare      Decimal           @default(0)
  totalBill         Decimal           @default(0)
  totalPaid         Decimal           @default(0)
  previousDue       Decimal           @default(0)
  currentDue        Decimal           @default(0)
  carryToNext       Decimal           @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, monthYear])
}

// ==================== DAILY SUMMARY ====================
model DailySummary {
  id                String            @id @default(cuid())
  date              DateTime          @unique
  dailyMarketCost   Decimal           @default(0)
  dailyTotalMeal    Int               @default(0)
  runningMarketCost Decimal           @default(0)
  runningTotalMeal  Int               @default(0)
  mealRate          Decimal           @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== NOTIFICATION ====================
model Notification {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  link              String?
  isRead            Boolean           @default(false)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== EMAIL LOG ====================
model EmailLog {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email             String
  subject           String
  message           String
  html              String?
  sentAt            DateTime          @default(now())
  
  createdAt         DateTime          @default(now())
}