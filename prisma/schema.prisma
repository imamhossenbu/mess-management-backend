// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================
enum Role {
  SUPER_ADMIN
  MANAGER
  MEMBER
}

enum MessRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum PaymentType {
  CASH
  DEBT
  SELF
}

enum InventoryType {
  MEAT
  FISH
}

enum BillType {
  CURRENT
  WIFI
  RENT
  WATER
  KHALA
}

enum DebtStatus {
  DUE
  PAID
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_BANKING
}

enum NotificationType {
  BILL
  PAYMENT
  MEAL
  INVENTORY
  SUMMARY
  EMAIL
  SYSTEM
}

// ==================== MESS ====================
model Mess {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  address           String?
  phone             String?
  email             String?
  logo              String?
  city              String?
  country           String?
  maxMembers        Int               @default(50)
  isActive          Boolean           @default(true)
  
  members           MessMember[]
  meals             Meal[]
  marketings        Marketing[]
  utilityBills      UtilityBill[]
  shopDebts         ShopDebt[]
  payments          Payment[]
  monthlySummaries  MonthlySummary[]
  inventories       Inventory[]
  inventoryLogs     InventoryLog[]
  dailySummaries    DailySummary[]
  shopMonthlySummaries ShopMonthlySummary[]
  carryForwards     CarryForward[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
// ==================== USER ====================
model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  phone             String?
  password          String
  profileImage      String?
  isActive          Boolean           @default(true)
  
  // Relations
  messMembers       MessMember[]
  notifications     Notification[]
  emailLogs         EmailLog[]
  utilityBills      UtilityBill[]      @relation("Payer")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MESS MEMBER ====================
model MessMember {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  role              MessRole          @default(MEMBER)
  joinedDate        DateTime          @default(now())
  leftDate          DateTime?
  isActive          Boolean           @default(true)
  
  // Relations
  meals             Meal[]
  marketings        Marketing[]
  payments          Payment[]
  monthlySummaries  MonthlySummary[]
  userBalance       UserBalance?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, messId])
}

// ==================== USER BALANCE ====================
model UserBalance {
  id                String            @id @default(cuid())
  memberId          String            @unique
  member            MessMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  balance           Decimal           @default(0)
  lastUpdated       DateTime          @default(now())
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MEAL ====================
model Meal {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  memberId          String
  member            MessMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date              DateTime
  morning           Boolean           @default(false)
  lunch             Boolean           @default(false)
  dinner            Boolean           @default(false)
  totalMeal         Int               @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([memberId, date])
}

// ==================== MARKETING ====================
model Marketing {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  memberId          String
  member            MessMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date              DateTime          @default(now())
  itemName          String
  quantity          String?
  amount            Decimal
  paymentType       PaymentType       @default(CASH)
  shopName          String?
  note              String?
  
  inventoryLogs     InventoryLog[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== INVENTORY ====================
model Inventory {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  type              InventoryType
  quantity          Int               @default(0)
  lastUpdated       DateTime          @default(now())
  
  logs              InventoryLog[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([messId, type])
}

// ==================== INVENTORY LOG ====================
model InventoryLog {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  inventoryId       String
  inventory         Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  change            Int
  reason            String
  marketingId       String?
  marketing         Marketing?        @relation(fields: [marketingId], references: [id])
  note              String?
  date              DateTime          @default(now())
  
  createdAt         DateTime          @default(now())
}

// ==================== UTILITY BILL ====================
model UtilityBill {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  billType          BillType
  monthYear         DateTime
  amount            Decimal
  paidBy            String?
  payer             User?             @relation("Payer", fields: [paidBy], references: [id])
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== SHOP DEBT ====================
model ShopDebt {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  shopName          String
  date              DateTime          @default(now())
  itemDetails       String?
  amount            Decimal
  status            DebtStatus        @default(DUE)
  paidDate          DateTime?
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== SHOP MONTHLY SUMMARY ====================
model ShopMonthlySummary {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  monthYear         DateTime
  totalDebt         Decimal           @default(0)
  totalPaid         Decimal           @default(0)
  currentDue        Decimal           @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([messId, monthYear])
}

// ==================== CARRY FORWARD ====================
model CarryForward {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  fromMonth         DateTime
  toMonth           DateTime
  itemName          String
  totalAmount       Decimal
  usedAmount        Decimal           @default(0)
  carryAmount       Decimal
  note              String?
  isAdjusted        Boolean           @default(false)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== PAYMENT ====================
model Payment {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  memberId          String
  member            MessMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount            Decimal
  paymentDate       DateTime          @default(now())
  paymentMethod     PaymentMethod     @default(CASH)
  note              String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== MONTHLY SUMMARY ====================
model MonthlySummary {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  memberId          String
  member            MessMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthYear         DateTime
  totalMeal         Int               @default(0)
  mealRate          Decimal           @default(0)
  mealBill          Decimal           @default(0)
  utilityShare      Decimal           @default(0)
  totalBill         Decimal           @default(0)
  totalPaid         Decimal           @default(0)
  previousDue       Decimal           @default(0)
  currentDue        Decimal           @default(0)
  carryToNext       Decimal           @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([memberId, monthYear])
}

// ==================== DAILY SUMMARY ====================
model DailySummary {
  id                String            @id @default(cuid())
  messId            String
  mess              Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  date              DateTime
  dailyMarketCost   Decimal           @default(0)
  dailyTotalMeal    Int               @default(0)
  runningMarketCost Decimal           @default(0)
  runningTotalMeal  Int               @default(0)
  mealRate          Decimal           @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([messId, date])
}

// ==================== NOTIFICATION ====================
model Notification {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  link              String?
  isRead            Boolean           @default(false)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ==================== EMAIL LOG ====================
model EmailLog {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email             String
  subject           String
  message           String
  html              String?
  sentAt            DateTime          @default(now())
  
  createdAt         DateTime          @default(now())
}